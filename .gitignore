# ============================================================
# Quant Cluster — Git Ignore
# ============================================================

# Environment / Secrets
.env
*.env
!*.env.example
*.key
*.pem
auth.json

# Runtime artifacts
shared_workspace/*
!shared_workspace/.gitkeep
!shared_workspace/papers/
!shared_workspace/papers/scanned/
!shared_workspace/papers/scanned/.gitkeep

# Papers workspace — runtime data (PDFs, DBs, reports)
shared_workspace/papers/raw/
shared_workspace/papers/reports/
shared_workspace/papers/*.db
shared_workspace/papers/*.md
shared_workspace/papers/*.py
shared_workspace/papers/*.json
data_router/cache/*.db

# Agent runtime (auto-generated when containers start)
agent_configs/*/.cache/
agent_configs/*/sessions/
agent_configs/*/home/
agent_configs/*/.local/
agent_configs/*/skills/*
!agent_configs/paper_manager/
!agent_configs/paper_manager/skills/
!agent_configs/paper_manager/skills/paper-scanning/
!agent_configs/paper_manager/skills/paper-scanning/**
agent_configs/*/.env
agent_configs/*/auth.json
agent_configs/*/models_dev_cache.json
agent_configs/*/.skills_prompt_snapshot.json
agent_configs/*/.tirith-install-failed
agent_configs/*/.lock
agent_configs/*/auth.lock
agent_configs/*/gateway.lock
agent_configs/*/gateway.pid
agent_configs/*/gateway_state.json
agent_configs/*/channel_directory.json
agent_configs/*/cron/
agent_configs/*/logs/
agent_configs/*/bin/
agent_configs/*/memories/
agent_configs/*/state.db*
agent_configs/*/response_store.db*
agent_configs/*/kanban.db*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db

# Orchestrator runtime state
orchestrator/orchestrator.db
orchestrator/orchestrator.db-*

# Playwright MCP temporary files
.playwright-mcp/

# Temporary SQLite databases created by tools
None

# Session/task artifacts
*.session
*.task
.tasks/

