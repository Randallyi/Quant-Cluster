# ============================================================
# Quant Cluster — Environment Configuration Template
# Copy this file to .env and fill in your actual API keys
# ============================================================

# LLM Provider (Anthropic API compatible)
# Examples: Kimi Code, OpenRouter, Claude, etc.
ANTHROPIC_BASE_URL=https://api.your-provider.com/coding/
ANTHROPIC_API_KEY=your_api_key_here

# Tavily Search API (used by Hypothesis Agent for literature research)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Data Router (usually auto-configured by docker-compose.yml)
# TWS_HOST=host.docker.internal
# TWS_PORT=7497

# yfinance Proxy (optional — set if you need proxy to access Yahoo Finance)
# HTTP_PROXY=http://host.docker.internal:33210
# HTTPS_PROXY=http://host.docker.internal:33210

# WebBridge (auto-configured to host.docker.internal:10086)
# WEBBRIDGE_HOST=host.docker.internal
# WEBBRIDGE_PORT=10086
